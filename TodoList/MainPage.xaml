<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TodoList.MainPage">

    <Grid RowDefinitions="100, Auto, *"
          ColumnDefinitions=".75*, .25*"
          Padding="10"
          RowSpacing="10" 
          ColumnSpacing="10">


        <Image Grid.ColumnSpan="2"
               Source="thingstodo.jpg"
               BackgroundColor="Transparent"/>

        <Entry x:Name ="TodoListEntry"
            Placeholder="Enter your task"
               Grid.Row="1"
               
        />

        <Button 
           
            Text="Add"
                Grid.Row="1"
                Grid.Column="1"
            Clicked="OnButtonClick"
            />
        
        

        <CollectionView x:Name="TodoListView"
            Grid.Row="2" Grid.ColumnSpan="2"
                        ItemsSource="{Binding MyList}" SelectionMode="Multiple" Margin="10" >
            <CollectionView.ItemTemplate>
                <DataTemplate>
                  
                    <StackLayout Orientation="Horizontal">
                        <Label Text="{Binding .}" FontSize="20" FontAttributes="Bold" 
                          />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Delete"
                Grid.Row="2"
                Grid.Column="1"
                Clicked="OnDeleteClick"
                />
    </Grid>

</ContentPage>