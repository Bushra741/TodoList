<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TodoList.MoreInfo"
             Title="MoreInfo">
    <ScrollView>
        <VerticalStackLayout
       
        Padding="20" Spacing="15">
        <Label Text="{Binding ListTitle}" FontSize="24" Margin="0,0,0,20"/>
        
            <Label Text="Description" FontAttributes="Bold" />
            <Editor Text="{Binding Description, Mode=TwoWay}" x:Name="DescriptionEditor" HeightRequest="120" />
            <Button Text="Save" Clicked="SaveClicked"/>
        <Button Text="Go back" Clicked="backClicked" />
        
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>